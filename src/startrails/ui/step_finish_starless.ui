  <property name="styleSheet">
   <string notr="true">QFrame#unconfigured_box {
    background-color: #fffbeb;
    border: 1px solid #fef3c7;
    border-radius: 6px;
    padding: 8px;
}
QLabel#lbl_unconf_msg {
    color: #92400e;
    font-size: 11px;
    line-height: 1.3;
}
QFrame#configured_box {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 6px 8px;
}
QLabel#lbl_provider_dot {
    color: #10b981;
    font-size: 11px;
    font-weight: bold;
}
QLabel#lbl_provider_info {
    font-size: 11px;
    font-weight: 600;
    color: #1e293b;
}
QLabel#lbl_strength_title, QLabel#lbl_scope_title, QLabel#lbl_structure_title, QLabel#lbl_detail_title {
    font-size: 11px;
    font-weight: 600;
    color: #475569;
}
QLabel#lbl_strength_value, QLabel#lbl_structure_value, QLabel#lbl_detail_value {
    font-size: 11px;
    font-weight: 600;
    color: #0369a1;
}
QRadioButton {
    font-size: 11px;
    color: #334155;
    font-weight: 500;
    spacing: 5px;
}
QRadioButton:focus {
    border: none;
    outline: none;
}
QSlider {
    border: none;
    padding: 0px;
    margin: 0px;
    min-height: 20px;
    max-height: 20px;
}
QSlider:focus {
    border: none;
    outline: none;
}
QPushButton#btn_reset {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 11px;
}
QPushButton#btn_reset:hover {
    background-color: #f1f5f9;
}
QPushButton#btn_reset:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e2e8f0;
}
QCheckBox#check_enable_denoise, QCheckBox#check_enable_sharpen {
    spacing: 0px;
    border: none;
    padding: 0px;
}
QCheckBox#check_enable_denoise::indicator, QCheckBox#check_enable_sharpen::indicator {
    width: 36px;
    height: 20px;
    border-radius: 10px;
}
QCheckBox#check_enable_denoise::indicator:unchecked, QCheckBox#check_enable_sharpen::indicator:unchecked {
    image: url(:/startrails/ui/switch_off.svg);
}
QCheckBox#check_enable_denoise::indicator:checked, QCheckBox#check_enable_sharpen::indicator:checked {
    image: url(:/startrails/ui/switch_on.svg);
}
QCheckBox#check_enable_denoise:focus, QCheckBox#check_enable_sharpen:focus,
QCheckBox#check_enable_denoise:focus:enabled, QCheckBox#check_enable_sharpen:focus:enabled {
    border: none;
    outline: none;
}
QLabel#lbl_status {
    color: #b91c1c;
    font-size: 11px;
    line-height: 1.3;
}</string>
