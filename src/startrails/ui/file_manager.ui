  <property name="styleSheet">
   <string notr="true">QFrame#fileSection {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}
QFrame#fileSection:hover {
    border-color: #cbd5e1;
}
QLabel#chevron {
    min-width: 14px;
    max-width: 14px;
    image: url(:/startrails/ui/chevron_right.svg);
}
QLabel#chevron[expanded="true"] {
    image: url(:/startrails/ui/chevron_down.svg);
}
QToolButton#toggle {
    border: 2px solid transparent;
    background: transparent;
    font-weight: bold;
    font-size: 12px;
    color: #0f172a;
    padding: 0px;
}
QLabel#count {
    background-color: #f1f5f9;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 9px;
    min-width: 14px;
}
QPushButton#add {
    border: 2px solid transparent;
    border-radius: 3px;
    font-weight: bold;
    font-size: 13px;
    color: #475569;
    background: transparent;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}
QPushButton#add:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}
QTreeView#files {
    border: none;
    background: transparent;
}
QTreeView#files::item {
    padding: 2px 0px;
    border-radius: 4px;
}
QTreeView#files::item:hover {
    background-color: #f8fafc;
}
QTreeView#files::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-weight: 600;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    padding: 3px 6px;
}
QLabel#empty {
    color: #64748b;
    font-size: 12px;
    font-style: italic;
    padding: 12px;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    color: #0f172a;
}
QMenu::item:selected {
    background-color: #f1f5f9;
    color: #0f172a;
}
QMenu::separator {
    height: 1px;
    background-color: #e2e8f0;
    margin: 4px 6px;
}
QToolButton#toggle:focus:enabled { border-color: #0f172a; }
QPushButton#add:focus:enabled { border-color: #0f172a; }</string>
