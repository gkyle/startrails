  <property name="styleSheet">
   <string notr="true">QFrame#fileSection {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}
QFrame#fileSection:hover {
    border-color: #cbd5e1;
}
QLabel#chevron {
    font-size: 10px;
    color: #64748b;
    font-weight: bold;
}
QToolButton#toggle {
    border: none;
    background: transparent;
    font-weight: bold;
    font-size: 12px;
    color: #0f172a;
    padding: 0px;
}
QLabel#count {
    background-color: #f1f5f9;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 9px;
    min-width: 14px;
}
QPushButton#add {
    border: none;
    border-radius: 3px;
    font-weight: bold;
    font-size: 13px;
    color: #475569;
    background: transparent;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}
QPushButton#add:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}
QTreeView#files {
    border: none;
    background: transparent;
}
QTreeView#files::item {
    padding: 2px 0px;
    border-radius: 4px;
}
QTreeView#files::item:hover {
    background-color: #f8fafc;
}
QTreeView#files::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-weight: 600;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    padding: 3px 6px;
}
QLabel#empty {
    color: #94a3b8;
    font-size: 12px;
    font-style: italic;
    padding: 12px;
}
QPushButton#remove, QPushButton#exclude {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 500;
}
QPushButton#remove:hover, QPushButton#exclude:hover {
    background-color: #f1f5f9;
    color: #0f172a;
    border-color: #94a3b8;
}
QPushButton#remove:disabled, QPushButton#exclude:disabled {
    color: #94a3b8;
    border-color: #e2e8f0;
    background-color: #f8fafc;
}</string>
