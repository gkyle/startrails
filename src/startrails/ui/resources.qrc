  <file alias="arrow_down.svg">icons/arrow_down.svg</file>
  <file alias="arrow_up_dark.svg">icons/arrow_up_dark.svg</file>
  <file alias="arrow_down_dark.svg">icons/arrow_down_dark.svg</file>
  <file alias="star.svg">icons/star.svg</file>
  <file alias="document.svg">icons/document.svg</file>
  <file alias="document_dark.svg">icons/document_dark.svg</file>
  <file alias="document_output.svg">icons/document_output.svg</file>
  <file alias="switch_on.png">icons_darktheme/switch_on.png</file>
  <file alias="switch_off.png">icons_darktheme/switch_off.png</file>
 </qresource>
</RCC>
