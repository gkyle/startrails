}
QLabel#lbl_round_stars_title, QLabel#lbl_glow_count_title, QLabel#lbl_glow_amount_title, QLabel#lbl_glow_radius_title, QLabel#lbl_star_cutoff_title, QLabel#lbl_preview_title {
    font-size: 11px;
    font-weight: 600;
    color: #475569;
}
QLabel#lbl_round_stars_value, QLabel#lbl_glow_amount_value, QLabel#lbl_glow_radius_value {
    font-size: 11px;
    font-weight: 600;
    color: #0369a1;
}
QCheckBox {
    font-size: 11px;
    color: #1e293b;
    font-weight: 600;
    spacing: 6px;
}
QRadioButton {
    font-size: 11px;
    color: #334155;
    font-weight: 500;
    spacing: 5px;
}
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: #1e293b;
}
QComboBox:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QPushButton#btn_reset, QPushButton#btn_compare {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 11px;
}
QPushButton#btn_compare:pressed {
    background-color: #e2e8f0;
    color: #0f172a;
    border-color: #94a3b8;
}
QPushButton#btn_reset:hover, QPushButton#btn_compare:hover {
    background-color: #f1f5f9;
}
QPushButton#btn_reset:disabled, QPushButton#btn_compare:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e2e8f0;
}
QLabel#lbl_status {
    color: #b91c1c;
    font-size: 11px;
    line-height: 1.3;
}</string>
