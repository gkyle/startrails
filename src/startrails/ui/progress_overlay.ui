  <property name="styleSheet">
   <string notr="true">QFrame#progressOverlay {
    background-color: rgba(15, 23, 42, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
}
QLabel {
    background: transparent;
}
QLabel#label_progressTitle {
    color: #f8fafc;
    font-size: 14px;
    font-weight: 600;
}
QLabel#label_progressBar {
    color: #94a3b8;
    font-size: 11px;
}
QLabel#label_progressPercent {
    color: #f1f5f9;
    font-size: 11px;
    font-weight: 600;
    min-width: 32px;
}
QLabel#label_progressElapsed, QLabel#label_progressETA {
    color: #94a3b8;
    font-size: 11px;
}
QProgressBar#progressBar {
    background-color: #334155;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}
QProgressBar#progressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #38bdf8);
    border-radius: 3px;
}
QPushButton#pushButton_cancelOp {
    background-color: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(148, 163, 184, 0.25);
    border-radius: 6px;
    color: #f43f5e;
    font-weight: bold;
    font-size: 13px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}
QPushButton#pushButton_cancelOp:hover {
    background-color: rgba(244, 63, 94, 0.15);
    border-color: #f43f5e;
    color: #ff4d6d;
}
QPushButton#pushButton_cancelOp:focus:enabled { border-color: #ffffff; }</string>
