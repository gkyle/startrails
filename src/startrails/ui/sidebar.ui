  <property name="styleSheet">
   <string notr="true">QWidget#sidebar {
    background-color: #f8fafc;
}
QScrollArea#scroll {
    border: none;
    background: transparent;
}
QWidget#content {
    background-color: #f8fafc;
}
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 6px;
    border-radius: 3px;
    margin: 2px 0px 2px 0px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    height: 0px;
}
QLabel#projectTitle, QLabel#operationsTitle {
    font-size: 15px;
    font-weight: bold;
    color: #0f172a;
}
QLabel#operationsProgressLabel {
    font-size: 11px;
    color: #64748b;
    font-weight: 500;
}
QProgressBar#operationsProgress {
    background-color: #e2e8f0;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
    border: none;
}
QProgressBar#operationsProgress::chunk {
    background-color: #16a34a;
    border-radius: 3px;
}
QPushButton#newProject, QPushButton#openProject {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
    font-size: 12px;
}
QPushButton#newProject:hover, QPushButton#openProject:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}
QPushButton#newProject:pressed, QPushButton#openProject:pressed {
    background-color: #e2e8f0;
}</string>
