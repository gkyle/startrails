}
QPushButton#masks, QPushButton#training {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
    font-size: 12px;
}
QPushButton#masks:hover, QPushButton#training:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}
QPushButton#masks:disabled, QPushButton#training:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QFrame#sep1, QFrame#sep2 {
    background-color: #f1f5f9;
    max-height: 1px;
}</string>
