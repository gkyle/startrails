 <widget class="QWidget" name="reviewSettings">
  <property name="styleSheet">
   <string notr="true">QLabel#contributeHeading, QLabel#findBrightestHeading {
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 2px;
}
QLabel#contributeHint, QLabel#findBrightestHint {
    font-size: 11px;
    color: #64748b;
    line-height: 1.3;
}
QFrame#statAuto {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 6px;
}
QFrame#statManual {
    background-color: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 6px;
}
QFrame#statDeleted {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 6px;
}
QLabel#statAutoTitle {
    font-size: 11px;
    font-weight: 600;
    color: #15803d;
}
QLabel#statManualTitle {
    font-size: 11px;
    font-weight: 600;
    color: #0284c7;
}
QLabel#statDeletedTitle {
    font-size: 11px;
    font-weight: 600;
    color: #b45309;
}
QLabel#statAutoNum {
    font-size: 17px;
    font-weight: bold;
    color: #166534;
}
QLabel#statManualNum {
    font-size: 17px;
    font-weight: bold;
    color: #0369a1;
}
QLabel#statDeletedNum {
    font-size: 17px;
    font-weight: bold;
    color: #92400e;
}
QPushButton#training, QPushButton#findBrightest {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
    font-size: 12px;
}
QPushButton#training:hover, QPushButton#findBrightest:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}
QPushButton#findBrightest:checked {
    background-color: #e0f2fe;
    color: #0284c7;
    border-color: #0284c7;
    font-weight: 600;
}
QPushButton#training:disabled, QPushButton#findBrightest:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QFrame#sep1, QFrame#sepFindBrightest {
    background-color: #f1f5f9;
    max-height: 1px;
}</string>
