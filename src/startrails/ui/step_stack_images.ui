       <property name="styleSheet">
        <string notr="true">QFrame#stackStreaksContainer {
    background-color: #f1f5f9;
    border-radius: 5px;
    padding: 2px;
}
QPushButton#stackStreaksKeep, QPushButton#stackStreaksRemove {
    background-color: transparent;
    color: #334155;
    border: 2px solid transparent;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 14px;
    min-height: 18px;
}
QPushButton#stackStreaksKeep:checked, QPushButton#stackStreaksRemove:checked {
    background-color: #0369a1;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#stackStreaksKeep:hover:!checked, QPushButton#stackStreaksRemove:hover:!checked {
    background-color: #e2e8f0;
    color: #0f172a;
}
QPushButton#stackStreaksRemove:disabled {
    color: #94a3b8;
    background-color: transparent;
}
QPushButton#stackStreaksKeep:focus:enabled, QPushButton#stackStreaksRemove:focus:enabled { border-color: #0f172a; }
QPushButton#stackStreaksKeep:checked:focus:enabled, QPushButton#stackStreaksRemove:checked:focus:enabled { border-color: #ffffff; }</string>
