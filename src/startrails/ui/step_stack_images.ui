  <property name="styleSheet">
   <string notr="true">QLabel {
    color: #334155;
    font-size: 12px;
}
QDoubleSpinBox, QSpinBox, QComboBox, QLineEdit {
    background-color: #ffffff;
    border: 1px solid #64748b;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 12px;
    color: #0f172a;
}
QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus, QLineEdit:focus {
    border: 2px solid #0369a1;
    padding: 3px 5px;
}
QCheckBox {
    font-size: 12px;
    color: #1e293b;
    spacing: 6px;
    border: 2px solid transparent;
}
QLabel#memory {
    font-size: 11px;
    color: #64748b;
}
QLabel#error {
    font-size: 11px;
    color: #b91c1c;
}
QPushButton#run {
    font-weight: bold;
    background-color: #0369a1;
    color: #ffffff;
    padding: 0px 12px;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    font-size: 13px;
    border: 2px solid transparent;
    min-height: 34px;
    max-height: 34px;
}
QPushButton#run:hover {
    background-color: #075985;
}
QPushButton#run:disabled {
    background-color: #e2e8f0;
    color: #94a3b8;
}
QPushButton#run:focus:enabled { border-color: #ffffff; }
QToolButton#advancedToggle {
    background-color: #0369a1;
    color: #ffffff;
    padding: 0px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border: 2px solid transparent;
    border-left: 1px solid #075985;
    min-height: 34px;
    max-height: 34px;
    min-width: 28px;
    max-width: 28px;
}
QToolButton#advancedToggle:hover {
    background-color: #075985;
}
QToolButton#advancedToggle:focus:enabled {
    border-color: #ffffff;
}
QToolButton#advancedToggle:disabled {
    background-color: #e2e8f0;
    color: #94a3b8;
    border-left: 1px solid #cbd5e1;
}
QCheckBox:focus:enabled { border-color: #0f172a; }
QDoubleSpinBox::up-arrow, QSpinBox::up-arrow { image: url(:/startrails/ui/arrow_up.svg); width: 10px; height: 6px; }
QDoubleSpinBox::down-arrow, QSpinBox::down-arrow { image: url(:/startrails/ui/arrow_down.svg); width: 10px; height: 6px; }</string>
